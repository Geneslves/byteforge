{
  "name": "byteforge",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "22.x",
    "pnpm": "10.33.0"
  },
  "description": "ByteForge - 数字熔炉 | Tech Blog",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev dist --persist-to .wrangler/state --port 8788",
    "dev:local": "wrangler pages dev dist --persist-to .wrangler/state",
    "dev:nodejs": "node server/index.js",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-dev.ps1",
    "clean": "node scripts/clean.js",
    "deploy:env": "node scripts/create-deploy-env.js",
    "api:test:local": "node scripts/api/integration-local.js",
    "check": "node scripts/check-project.js && node scripts/check-content.js && node scripts/build.js && pagefind --site dist --output-subdir pagefind && node scripts/check-routes.js && node scripts/check-static.js && node scripts/check-head.js && node scripts/check-source.js && node scripts/check-visual.js && node scripts/check-auth.js && node scripts/check-backend.js && node scripts/check-production-server.js && node scripts/check-infra.js && node scripts/check-performance.js",
    "build": "node scripts/build.js && pagefind --site dist --output-subdir pagefind",
    "build:site": "node scripts/build.js",
    "build:pagefind": "pagefind --site dist --output-subdir pagefind",
    "check:project": "node scripts/check-project.js",
    "check:routes": "node scripts/check-routes.js",
    "check:content": "node scripts/check-content.js",
    "check:static": "node scripts/check-static.js",
    "check:head": "node scripts/check-head.js",
    "check:source": "node scripts/check-source.js",
    "check:visual": "node scripts/check-visual.js",
    "check:auth": "node scripts/check-auth.js",
    "check:backend": "node scripts/check-backend.js",
    "check:production-server": "node scripts/check-production-server.js",
    "check:infra": "node scripts/check-infra.js",
    "check:deploy-config": "node scripts/check-deploy-config.js",
    "check:performance": "node scripts/check-performance.js",
    "audit": "corepack pnpm audit --registry=https://registry.npmjs.org --audit-level=moderate",
    "preview": "vite preview",
    "db:init": "wrangler d1 execute byteforge --local --file=./schema/d1.sql",
    "db:reset:local": "node scripts/db/reset-local.js",
    "db:seed:local": "node scripts/db/seed-local.js",
    "db:migrate": "node scripts/db/migrate.js",
    "db:migrate:dev": "node scripts/db/migrate.js byteforge-dev",
    "db:migrate:staging": "node scripts/db/migrate.js byteforge-staging --remote",
    "db:migrate:production": "node scripts/db/migrate.js byteforge --remote",
    "db:cleanup": "node scripts/db/cleanup.js",
    "db:cleanup:dev": "node scripts/db/cleanup.js byteforge-dev",
    "db:cleanup:staging": "node scripts/db/cleanup.js byteforge-staging --remote",
    "db:cleanup:production": "node scripts/db/cleanup.js byteforge --remote",
    "db:backup": "node scripts/db/backup.js",
    "db:backup:dev": "node scripts/db/backup.js byteforge-dev",
    "db:backup:staging": "node scripts/db/backup.js byteforge-staging --remote",
    "db:backup:production": "node scripts/db/backup.js byteforge --remote",
    "db:view": "node scripts/db/view-db.js",
    "db:users": "node scripts/db/view-db.js --users",
    "db:admins": "node scripts/db/view-db.js --admins",
    "db:feedback": "node scripts/db/view-db.js --feedback",
    "db:stats": "node scripts/db/view-db.js --stats",
    "postgres:migrate": "node scripts/migrate-postgres.js",
    "postgres:init": "node scripts/migrate-postgres.js",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "docker:restart": "docker compose restart app",
    "docker:clean": "docker compose down -v"
  },
  "devDependencies": {
    "pagefind": "^1.5.2",
    "vite": "^6.3.5",
    "wrangler": "^4.100.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "pg": "^8.11.3"
  }
}
