# ByteForge Environment Configuration
# Copy this file to .env and update with your values

# ============================================
# Application Settings
# ============================================
NODE_ENV=production
PORT=3000

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
DATABASE_URL=postgresql://byteforge:byteforge_password@localhost:5432/byteforge

# Or separate components:
POSTGRES_USER=byteforge
POSTGRES_PASSWORD=byteforge_password
POSTGRES_DB=byteforge
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============================================
# JWT Authentication
# ============================================
# IMPORTANT: Change this in production!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-key-change-in-production

# ============================================
# Docker Compose Settings
# ============================================
APP_PORT=3000

# pgAdmin (optional)
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@byteforge.local
PGADMIN_PASSWORD=admin

# ============================================
# Platform Detection (auto-detected, do not set manually)
# ============================================
# CF_PAGES=           # Cloudflare Pages (auto-set)
# VERCEL=             # Vercel (auto-set)

# ============================================
# Development Settings
# ============================================
# LOG_LEVEL=debug
# ENABLE_CORS=true
