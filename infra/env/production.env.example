# Compose/deployment settings
DEPLOY_ENV=production
BYTEFORGE_HTTP_PORT=3000
BYTEFORGE_BACKUP_ROOT=/var/backups/byteforge/production

# Public origin and CORS
SITE_URL=https://www.thebyte.tech
SITE_ORIGIN=https://www.thebyte.tech
ALLOWED_ORIGINS=https://www.thebyte.tech
REGISTRATION_ENABLED=false

# PostgreSQL
POSTGRES_USER=byteforge
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=byteforge

# Authentication
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Backup retention
BACKUP_RETENTION_DAYS=14
