# Compose/deployment settings
DEPLOY_ENV=staging
BYTEFORGE_HTTP_PORT=3001
BYTEFORGE_BACKUP_ROOT=/var/backups/byteforge/staging

# Keep generated SEO canonical URLs on production while allowing staging API use.
SITE_URL=https://www.thebyte.tech
SITE_ORIGIN=https://staging.thebyte.tech
ALLOWED_ORIGINS=https://staging.thebyte.tech
REGISTRATION_ENABLED=false

# PostgreSQL
POSTGRES_USER=byteforge_staging
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=byteforge_staging

# Authentication
JWT_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET

# Backup retention
BACKUP_RETENTION_DAYS=7
