{
	admin 127.0.0.1:2019
}

(byteforge_proxy) {
	encode zstd gzip
	reverse_proxy 127.0.0.1:{args[0]} {
		health_uri /api/health/ready
		health_interval 30s
		health_timeout 5s
	}
}

thebyte.tech {
	redir https://www.thebyte.tech{uri} permanent
}

www.thebyte.tech {
	import byteforge_proxy 3000
	log {
		output file /var/log/caddy/byteforge-production-access.log {
			roll_size 50MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}
}

staging.thebyte.tech {
	header X-Robots-Tag "noindex, nofollow, noarchive"
	import byteforge_proxy 3001
	log {
		output file /var/log/caddy/byteforge-staging-access.log {
			roll_size 25MiB
			roll_keep 5
			roll_keep_for 168h
		}
		format json
	}
}
